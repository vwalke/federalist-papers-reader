---
/**
 * A dismissible printer's notice above the nameplate, in the run-in style
 * the ReadPublius notice established: oxblood manicule, small-caps lead-in,
 * centered text, a hairline rule below. Reusable for future news — give each
 * item its own `id` and the dismissal persists per item, per browser.
 */
interface Props {
  /** Storage identity for this news item, e.g. 'aih-underway-2026'. */
  id: string;
  /** The small-caps lead-in, e.g. 'As It Happened is underway'. */
  label: string;
  /**
   * Render hidden and show only while As It Happened catch-up is open,
   * judged in the browser on the Eastern calendar (see catch-up-window.ts).
   */
  whileCatchUpOpen?: boolean;
}

const { id, label, whileCatchUpOpen = false } = Astro.props;
const storageKey = `publius:notice-dismissed:${id}`;
---

<script is:inline define:vars={{ storageKey }}>
  try {
    if (localStorage.getItem(storageKey) === '1') {
      document.documentElement.dataset.siteNoticeDismissed = '';
    }
  } catch {
    // The notice remains available when storage access is blocked.
  }
</script>

<aside
  class="site-notice"
  aria-labelledby="site-notice-title"
  data-site-notice
  data-catch-up-window={whileCatchUpOpen || undefined}
  hidden={whileCatchUpOpen}
>
  <p class="site-notice__body">
    <span class="site-notice__hand" aria-hidden="true">&#x261E;&#xFE0E;</span>
    <strong class="site-notice__label" id="site-notice-title">{label}</strong>.{' '}
    <slot />
  </p>
  <button
    class="site-notice__dismiss"
    type="button"
    aria-label="Dismiss notice"
    data-site-notice-dismiss
    hidden
  >
    <span aria-hidden="true">×</span>
  </button>
</aside>

<script>
  import { revealInCatchUpWindow } from '../lib/catch-up-window';

  revealInCatchUpWindow(document);
</script>

<script define:vars={{ storageKey }}>
  const notice = document.querySelector('[data-site-notice]');
  const dismiss = notice?.querySelector('[data-site-notice-dismiss]');

  if (notice && dismiss) {
    dismiss.addEventListener('click', () => {
      document.documentElement.dataset.siteNoticeDismissed = '';
      try {
        window.localStorage.setItem(storageKey, '1');
      } catch {
        // The document marker still dismisses the notice for this page.
      }
    });
    dismiss.hidden = false;
  }
</script>
