---
import debate from '../../workers/post/content/debate.json';
import {
  CATCH_UP_LAST_DAY,
  SEASON_OPENS,
  effectiveMonthDay,
  type DatedItem
} from '../../workers/post/src/season';

interface Props {
  /** The fine print links to /subscribe/; pass false there so it doesn't link to itself. */
  showLearnMore?: boolean;
}

const { showLearnMore = true } = Astro.props;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
// Anniversaries a late joiner could still catch up on: opening day through the
// cut-off. The script below counts those already printed and shows the offer
// only while the window is open, so the static page never goes stale.
const catchUpDays = (debate.items as DatedItem[])
  .map(effectiveMonthDay)
  .filter((day) => day >= SEASON_OPENS && day <= CATCH_UP_LAST_DAY)
  .sort();
---

<aside class="subscribe-coupon" aria-labelledby="subscribe-coupon-title">
  <h2 id="subscribe-coupon-title" class="subscribe-coupon__title">By Subscription</h2>
  <p class="subscribe-coupon__pitch">
    Have Publius call at your address&mdash;the next paper, and every one after it.
  </p>
  <form class="subscribe-coupon__form" method="post" action="/api/subscribe">
    <fieldset class="subscribe-coupon__programs">
      <legend class="visually-hidden">Delivery program</legend>
      <label class="subscribe-coupon__program">
        <input type="radio" name="program" value="weekly" checked />
        <span>The Weekly Course&mdash;one paper each week</span>
      </label>
      <label class="subscribe-coupon__program">
        <input type="radio" name="program" value="calendar" />
        <span>As It Happened&mdash;on the original dates</span>
      </label>
      <label class="subscribe-coupon__catchup" data-catchup data-days={JSON.stringify(catchUpDays)} hidden>
        <input type="checkbox" name="catchup" value="1" checked disabled />
        <span>
          <span class="subscribe-coupon__catchup-title">
            Catch up on the <span data-catchup-count>papers</span> already printed
          </span>
          <span class="subscribe-coupon__catchup-note">
            One extra each morning, earliest first, until you&rsquo;re level with the season.
          </span>
        </span>
      </label>
    </fieldset>
    <p class="subscribe-coupon__honeypot" aria-hidden="true">
      <label>
        Leave this field empty
        <input type="text" name="contact_time" tabindex="-1" autocomplete="off" />
      </label>
    </p>
    <div class="subscribe-coupon__row">
      <label class="visually-hidden" for="subscribe-email">Email address</label>
      <input
        id="subscribe-email"
        type="email"
        name="email"
        required
        placeholder="your@address.com"
        autocomplete="email"
      />
      <button type="submit">Subscribe</button>
    </div>
    {turnstileSiteKey && (
      <>
        {/* Invisible operation is a widget MODE chosen when the sitekey is created
            in the Cloudflare dashboard — PUBLIC_TURNSTILE_SITE_KEY must belong to an
            invisible-mode widget. data-size is only for sizing visible widgets. */}
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
        <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
      </>
    )}
    <p class="subscribe-coupon__fine">
      Confirmed by return post. Leave whenever you like&mdash;unsubscribing is one click.{showLearnMore && (
        <>
          {' '}<a href="/subscribe/">Learn more.</a>
        </>
      )}
    </p>
  </form>
</aside>

<script>
  import { numberWord, signupCatchUpBehind } from '../../workers/post/src/season';

  // The same rule the Worker applies at confirmation, on the Eastern calendar:
  // papers dated before the reader's first live morning, which is tomorrow
  // once the daily run is out.
  for (const option of document.querySelectorAll<HTMLElement>('[data-catchup]')) {
    const form = option.closest('form');
    const box = option.querySelector<HTMLInputElement>('input[name="catchup"]');
    const count = option.querySelector('[data-catchup-count]');
    if (!form || !box || !count) continue;
    const behind = signupCatchUpBehind(JSON.parse(option.dataset.days ?? '[]'));
    if (behind === 0) continue;
    count.textContent = numberWord(behind);

    // Offered beneath As It Happened only; disabled (so never submitted) otherwise.
    const sync = () => {
      const calendar = form.querySelector('input[name="program"][value="calendar"]:checked') !== null;
      option.hidden = !calendar;
      box.disabled = !calendar;
    };
    form.addEventListener('change', sync);
    sync();
  }
</script>
