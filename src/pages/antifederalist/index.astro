---
import { getCollection } from 'astro:content';

import GazetteMasthead from '../../components/GazetteMasthead.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  essayDisplayName,
  essaySlug,
  getOrderedEssays,
  progressId
} from '../../lib/antifederalist';
import { toRomanNumeral } from '../../lib/paper-display';

import '../../styles/index.css';

const essays = getOrderedEssays(
  (await getCollection('antifederalist')).map((entry) => ({ ...entry, ...entry.data }))
);

const firstEssay = essays[0];

function formatDate(value: string): string {
  const [year, month, day] = value.split('-').map(Number);
  return new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC'
  }).format(new Date(Date.UTC(year, month - 1, day)));
}

---

<BaseLayout
  title="The Anti-Federalist Papers | Federalist Reader"
  description="Eight essays from Thomas Greenleaf’s New-York Journal — Brutus and Cato answering Publius in the same city, the same weeks, the same format."
  pageClass="index-page"
  ogImage="/social-cards/antifederalist-default.jpg"
>
  <div class="paper-sheet">
    <GazetteMasthead variant="new-york-journal" />

    <section class="index-ledger" id="opposition" aria-labelledby="opposition-heading">
      <header class="index-ledger__heading">
        <div>
          <p class="section-kicker">The opposition press</p>
          <h1 id="opposition-heading">The Anti-Federalist Papers</h1>
        </div>
        <p class="index-ledger__progress" data-journal-progress>0 of 8 read in this browser</p>
      </header>

      <p class="index-intro">
        While Publius argued for the Constitution in the Independent Journal and
        the Packet, Thomas Greenleaf’s New-York Journal carried the other side.
        These eight essays — Brutus’s systematic case and Cato on the presidency
        — met the Federalist argument in the same city, the same weeks, and the
        same newspaper columns. Read them beside the papers they answer.
      </p>

      <p class="index-continue">
        <a
          class="button-link"
          href={`/antifederalist/${essaySlug(firstEssay.data)}/`}
          data-continue-link
        >
          <span data-continue-label>Begin with {essayDisplayName(firstEssay.data)}</span>{' '}
          <span aria-hidden="true">→</span>
        </a>
      </p>

      {/* The rows carry h3 titles like the main ledger's; this keeps the
          heading outline stepping h1 → h2 → h3 without a visible label. */}
      <h2 class="visually-hidden">The eight essays</h2>

      <div class="index-ledger__labels" aria-hidden="true">
        <span>No.</span>
        <span>Essay and message</span>
        <span>Author</span>
        <span>Published</span>
        <span>Status</span>
      </div>

      <ol class="index-ledger__list">
        {essays.map((essay) => (
          <li
            class="index-entry"
            data-journal-entry={String(progressId(essay.data))}
            data-journal-slug={essaySlug(essay.data)}
            data-journal-name={essayDisplayName(essay.data)}
          >
            <p class="index-entry__number">
              <span class="visually-hidden">{essay.data.series} number </span>{toRomanNumeral(essay.data.seriesNumber)}
            </p>
            <div class="index-entry__message">
              <h3><a href={`/antifederalist/${essaySlug(essay.data)}/`}>{essay.data.title}</a></h3>
              <p>{essay.data.indexSummary}</p>
            </div>
            <p class="index-entry__author">{essay.data.series}</p>
            <p class="index-entry__date">
              <time datetime={essay.data.publicationDate}>{formatDate(essay.data.publicationDate)}</time>
            </p>
            <button
              class="index-entry__status"
              type="button"
              data-journal-status
              aria-pressed="false"
              aria-label={`Mark ${essayDisplayName(essay.data)} as read`}
              hidden
            >
              <span class="index-entry__printer-mark" aria-hidden="true">○</span>
              <span data-index-status-label>Unread</span>
            </button>
          </li>
        ))}
      </ol>

      <aside class="index-coda" aria-label="What happened to the Journal">
        <span class="section-kicker">The price of the argument</span>
        <p>
          Greenleaf paid for his columns. On the night of July 26, 1788 — as
          word that New York had ratified reached the city — a Federalist
          crowd of some five hundred sacked his printing office on
          Water-Street and carried off his type. He rebuilt,
          and the Journal kept publishing into the 1790s. The debate these
          sheets carried, though, had already become the country’s inheritance:
          it is in the dialogue, not merely the Federalist victory, that the
          principles are to be found.
        </p>
      </aside>
    </section>
  </div>
</BaseLayout>

<style>
  /* This shelf holds eight rows in the main index's five-column ledger idiom:
     the grid, labels row, and status toggle all come from index.css. Only the
     shelf-specific frame (heading scale, intro, coda) lives here. */
  .index-ledger__heading h1 {
    margin-block-start: var(--space-xs);
    font: 400 clamp(1.9rem, 4.2vw, 3rem) / 1.06 var(--font-display);
    text-wrap: balance;
  }

  .index-intro {
    max-inline-size: 62ch;
    margin-block-end: var(--space-lg);
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .index-continue {
    margin-block-end: var(--space-xl);
  }

  .index-coda {
    display: grid;
    gap: var(--space-sm);
    max-inline-size: 62ch;
    margin-block-start: var(--space-xl);
  }

  .index-coda p {
    line-height: 1.55;
  }
</style>

<script>
  import { createPreferences, getNextUnread } from '../../lib/preferences';

  let storage: Storage | null = null;
  try {
    storage = window.localStorage;
  } catch {
    // Read state stays server-rendered without storage; the list still works.
  }
  const preferences = createPreferences(storage);

  interface ShelfEntry {
    id: number;
    slug: string;
    name: string;
    row: HTMLElement;
  }

  const entries: ShelfEntry[] = [
    ...document.querySelectorAll<HTMLElement>('[data-journal-entry]')
  ].map((row) => ({
    id: Number(row.dataset.journalEntry),
    slug: row.dataset.journalSlug ?? '',
    name: row.dataset.journalName ?? '',
    row
  }));
  const summary = document.querySelector<HTMLElement>('[data-journal-progress]');

  function render() {
    const readNumbers = preferences.getReadPapers();
    let readCount = 0;

    for (const entry of entries) {
      const read = readNumbers.has(entry.id);
      if (read) readCount += 1;
      entry.row.dataset.read = String(read);
      const toggle = entry.row.querySelector<HTMLButtonElement>('[data-journal-status]');
      const label = entry.row.querySelector<HTMLElement>('[data-index-status-label]');
      const mark = entry.row.querySelector<HTMLElement>('.index-entry__printer-mark');
      if (toggle) {
        toggle.setAttribute('aria-pressed', String(read));
        toggle.setAttribute('aria-label', `Mark ${entry.name} as ${read ? 'unread' : 'read'}`);
      }
      if (label) label.textContent = read ? 'Read' : 'Unread';
      if (mark) mark.textContent = read ? '✓' : '○';
    }

    if (summary) summary.textContent = `${readCount} of ${entries.length} read in this browser`;

    /* Publication order is the shelf's reading order, so hand the ids to
       getNextUnread as-is rather than numerically sorted. */
    const nextId = getNextUnread(entries.map(({ id }) => id), readNumbers);
    const next = entries.find(({ id }) => id === nextId) ?? null;
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-continue-link]')) {
      const label = link.querySelector<HTMLElement>('[data-continue-label]');
      if (next) {
        link.href = `/antifederalist/${next.slug}/`;
        if (label) label.textContent = `Continue with ${next.name}`;
      } else if (entries.length > 0) {
        link.href = `/antifederalist/${entries[0].slug}/`;
        if (label) label.textContent = `Revisit ${entries[0].name}`;
      }
    }
  }

  /* Same contract as ProgressControl: a toggle writes the preference and
     announces it; anything listening (including this page) re-renders. */
  for (const entry of entries) {
    const toggle = entry.row.querySelector<HTMLButtonElement>('[data-journal-status]');
    if (!toggle) continue;
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      const read = !preferences.isPaperRead(entry.id);
      preferences.setPaperRead(entry.id, read);
      document.dispatchEvent(
        new CustomEvent('paper-read-change', { detail: { number: entry.id, read } })
      );
    });
  }

  document.addEventListener('paper-read-change', render);
  render();
</script>
